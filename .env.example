# RoozTextile - Environment Variables Template

# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# WhatsApp Business Number (Country code + phone digits, no '+')
WHATSAPP_NUMBER=918900300307

# MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/rooztextile?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/rooztextile
MONGODB_URI=

# Admin Login Credentials (Used for initial admin setup and fallback)
ADMIN_EMAIL=admin@rooztextile.com
ADMIN_PASSWORD=adminrooz2026!

# Admin Session Secret for signing tokens (Any long random string)
ADMIN_JWT_SECRET=rooztextile_super_secure_admin_jwt_secret_key_2026
